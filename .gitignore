# =========================================================
# Android & Gradle Build Outputs & Caches
# =========================================================
*.iml
.gradle/
/build/
app/build/
/captures
.externalNativeBuild
.cxx
*.apk
*.aab

# =========================================================
# IDE & Operating System Files
# =========================================================
.idea/
.vscode/
/local.properties
local.properties
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*.log

# =========================================================
# Personal Scripts, Python & Scratch Files
# =========================================================
count_code.py
__pycache__/
*.py[cod]
*$py.class
scratch/
ignore/

# =========================================================
# Sensitive Credentials & Private Keys (STRICTLY DISALLOWED)
# =========================================================
app/google-services.json
*firebase-adminsdk*.json
*serviceAccountKey*.json
secrets/
*.keystore
*.jks
*.p12
*.pem
*.key
.env
.env.*

# =========================================================
# Game Assets Privacy & Anti-Bloat Filters
# Only placeholder .md files are tracked for folder structure.
# Raw images, vector SVGs, audios, and binaries are excluded.
# =========================================================
assets/audios/*/*
!assets/audios/*/*.md

assets/imgs/*
!assets/imgs/*.md

assets/fonts/*
!assets/fonts/*.md

assets/bin/*
!assets/bin/*.md

assets/svg/*
!assets/svg/*.md

assets/txt/*
!assets/txt/*.md

app/src/main/res/drawable/*.png